[Unit]
Description=Ingame daily Steam pro account playtime snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/main
Environment=HOME=/root PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/main/venv/bin/python3 -m services.live_journal.steam_sampler playtime
Nice=19
CPUWeight=10
IOSchedulingClass=idle
MemoryHigh=128M
MemoryMax=256M
MemorySwapMax=0
OOMScoreAdjust=1000
TimeoutStartSec=3600
StandardOutput=append:/root/main/runtime/artifacts/misc/live_journal_steam.log
StandardError=append:/root/main/runtime/artifacts/misc/live_journal_steam.log
