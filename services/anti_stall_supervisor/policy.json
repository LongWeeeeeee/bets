{
  "schema": "anti_stall_policy_v1",
  "version": 1,
  "policy_id": "anti_stall_default_v1",
  "tick_interval_seconds": 300,
  "max_no_progress_seconds_default": 900,
  "min_no_progress_observations": 3,
  "min_stall_snapshots": 2,
  "protocol_max_attempts": 2,
  "default_action_cooldown_seconds": 300,
  "stale_heartbeat_seconds": 3600,
  "planner_assignees": ["planner"],
  "executable_child_statuses": ["todo", "ready", "running", "done"],
  "success_statuses": ["done"],
  "success_result_tokens": ["success", "completed", "ok"],
  "running_statuses": ["running"],
  "blocked_statuses": ["blocked"],
  "needs_input_statuses": ["needs_input"],
  "waiting_statuses": ["todo", "ready"],
  "registered_rules": ["dependency_all_parents_success_v1"],
  "permanent_deny_classes": [
    "needs_input",
    "human",
    "secret",
    "credential",
    "auth",
    "production_safety",
    "ownership",
    "reviewer_issues",
    "checksum_mismatch",
    "evidence_mismatch",
    "stale_approval"
  ],
  "deny_class_aliases": {
    "needs_input": ["needs_input", "need_input", "human_input"],
    "human": ["human", "manual", "operator"],
    "secret": ["secret", "secrets"],
    "credential": ["credential", "credentials", "password", "token"],
    "auth": ["auth", "authentication", "authorization"],
    "production_safety": ["production_safety", "production-safety", "prod_safety"],
    "ownership": ["ownership", "exclusive_ownership"],
    "reviewer_issues": ["reviewer_issues", "reviewer issues", "issues"],
    "checksum_mismatch": ["checksum_mismatch", "checksum", "hash_mismatch"],
    "evidence_mismatch": ["evidence_mismatch", "evidence", "parent_evidence"],
    "stale_approval": ["stale_approval", "stale-approval"]
  },
  "status_actions": ["unblock_same_card", "route_needs_replan"],
  "allowed_actions": ["comment_once", "unblock_same_card", "route_needs_replan", "noop"]
}
