<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ingame.serv2probe</string>
    <!-- Датчик доступности serv2 со стороны клиента.
         Исходник: scripts/ops/serv2_reach_probe.sh
         Снять: launchctl bootout gui/$(id -u)/com.ingame.serv2probe -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alex/Library/Application Support/ingame/serv2_reach_probe.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>/tmp/ingame_serv2_probe.err</string>
</dict>
</plist>
